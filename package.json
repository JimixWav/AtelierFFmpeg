{
  "name": "atelier-ffmpeg",
  "productName": "Atelier FFmpeg",
  "version": "1.3.0",
  "description": "Conversion et compression audio/vidéo locales avec FFmpeg, pour macOS.",
  "private": true,
  "main": "out/main/index.js",
  "author": "Jimix",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:mac-intel": "npm run build && electron-builder --mac --x64"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "ch.jimix.atelier-ffmpeg",
    "productName": "Atelier FFmpeg",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Atelier FFmpeg"
    }
  },
  "dependencies": {}
}
